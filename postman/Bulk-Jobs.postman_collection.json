{
  "info": {
    "name": "Bulk Charge Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every endpoint of the bulk job API. Run folders top to bottom; job ids are captured into collection variables by the test scripts. Local: docker compose up -d --build (baseUrl http://localhost:3000). Live: select the 'Bulk Charge - Live (Render)' environment, or set baseUrl to the deployed URL. Note: on Render's free plan the first request after ~15 min idle takes ~50 s while the service wakes up."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tenantId",
      "value": "tnt_demo"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "transitionJobId",
      "value": ""
    },
    {
      "key": "scheduledJobId",
      "value": ""
    },
    {
      "key": "entriesCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health (DB + Redis + registered actions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Postgres, Redis and the entity/action pairs the engine has registered."
          }
        },
        {
          "name": "API docs (Swagger UI) - open in browser",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs"
              ]
            },
            "description": "Interactive API docs; OpenAPI JSON at /docs-json"
          }
        }
      ]
    },
    {
      "name": "1. Apply charge (Action 1)",
      "item": [
        {
          "name": "Create charge job (Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "fsc-demo-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs"
              ]
            },
            "description": "Creates an apply_charge job selected by filter. The first call returns 201; a retry with the same key returns 200 + the original job.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"action_type\": \"apply_charge\",\n  \"entity_type\": \"shipment\",\n  \"filter\": {\n    \"origin_port\": \"INNSA\",\n    \"status\": \"in_transit\"\n  },\n  \"params\": {\n    \"charge_code\": \"FSC\",\n    \"basis\": \"per_kg\",\n    \"rate\": 0.12,\n    \"currency\": \"USD\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('jobId', b.id);",
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.test('201 new or 200 replay', () => pm.expect([200, 201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same Idempotency-Key -> 200 original job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "fsc-demo-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"action_type\": \"apply_charge\",\n  \"entity_type\": \"shipment\",\n  \"filter\": {\n    \"origin_port\": \"INNSA\",\n    \"status\": \"in_transit\"\n  },\n  \"params\": {\n    \"charge_code\": \"FSC\",\n    \"basis\": \"per_kg\",\n    \"rate\": 0.12,\n    \"currency\": \"USD\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 replay, same job', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('jobId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different body -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "fsc-demo-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"action_type\": \"apply_charge\",\n  \"entity_type\": \"shipment\",\n  \"filter\": {\n    \"origin_port\": \"INNSA\",\n    \"status\": \"in_transit\"\n  },\n  \"params\": {\n    \"charge_code\": \"FSC\",\n    \"basis\": \"per_kg\",\n    \"rate\": 9.99,\n    \"currency\": \"USD\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Job detail (live progress, ETA, batches, tenant rate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs",
                "{{jobId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Live progress stream (SSE) - pushes events until done",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs/{{jobId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs",
                "{{jobId}}",
                "events"
              ]
            },
            "description": "Server-Sent Events: a `progress` event every second, then a `done` event when the job finishes, and the stream closes. Terminal: curl -N {{baseUrl}}/v1/bulk-jobs/<id>/events"
          }
        },
        {
          "name": "Summary (success / failed / skipped + top reasons)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs/{{jobId}}/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs",
                "{{jobId}}",
                "summary"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Entries: failed only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs/{{jobId}}/entries?outcome=failed&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs",
                "{{jobId}}",
                "entries"
              ],
              "query": [
                {
                  "key": "outcome",
                  "value": "failed"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json(); if (b.next_cursor) pm.collectionVariables.set('entriesCursor', b.next_cursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "Entries: next page (cursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs/{{jobId}}/entries?outcome=failed&limit=20&cursor={{entriesCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs",
                "{{jobId}}",
                "entries"
              ],
              "query": [
                {
                  "key": "outcome",
                  "value": "failed"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "cursor",
                  "value": "{{entriesCursor}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Entries: success",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs/{{jobId}}/entries?outcome=success&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs",
                "{{jobId}}",
                "entries"
              ],
              "query": [
                {
                  "key": "outcome",
                  "value": "success"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Re-run same charge (new key) -> all skipped charge_already_applied",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "fsc-rerun-{{$timestamp}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs"
              ]
            },
            "description": "Entity-level idempotency: (shipment_id, charge_code) already exists -> skipped. Check Summary after a second.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"action_type\": \"apply_charge\",\n  \"entity_type\": \"shipment\",\n  \"filter\": {\n    \"origin_port\": \"INNSA\",\n    \"status\": \"in_transit\"\n  },\n  \"params\": {\n    \"charge_code\": \"FSC\",\n    \"basis\": \"per_kg\",\n    \"rate\": 0.12,\n    \"currency\": \"USD\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('jobId', b.id);",
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Per-container charge in EUR on imports",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"action_type\": \"apply_charge\",\n  \"entity_type\": \"shipment\",\n  \"filter\": {\n    \"trade_type\": \"import\"\n  },\n  \"params\": {\n    \"charge_code\": \"THC\",\n    \"basis\": \"per_container\",\n    \"rate\": 25,\n    \"currency\": \"EUR\"\n  }\n}"
            }
