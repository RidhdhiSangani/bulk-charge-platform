    {
      "name": "3. Scheduling & cancellation",
      "item": [
        {
          "name": "Schedule a job for 22 Nov 11:15pm IST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bulk-jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bulk-jobs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"action_type\": \"apply_charge\",\n  \"entity_type\": \"shipment\",\n  \"filter\": {\n    \"status\": \"arrived\"\n  },\n  \"params\": {\n    \"charge_code\": \"DEM\",\n    \"basis\": \"flat\",\n    \"rate\": 40,\n    \"currency\": \"USD\"\n  },\n  \"scheduled_at\": \"2030-11-22T23:15:00+05:30\"\n}"
            }
          },
          "event": [
