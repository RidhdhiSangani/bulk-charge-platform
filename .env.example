# Local dev against `docker compose up -d postgres redis` (Postgres on 5433, Redis on 6380)
DATABASE_URL=postgresql://shipmnts:shipmnts@localhost:5433/bulk_charge?connection_limit=20
REDIS_URL=redis://localhost:6380
PORT=3000
BATCH_SIZE=100
TENANT_RATE_LIMIT_PER_MIN=5000
LEASE_TTL_SECONDS=60
WORKER_CONCURRENCY=4
WATCHDOG_EVERY_MS=15000
CANCEL_CHECK_EVERY=10
SSE_INTERVAL_MS=1000
QUEUE_PREFIX=bull
# Single-service hosting (e.g. Render free plan): run workers inside the API, migrate on start
RUN_WORKERS_IN_API=false
MIGRATE_ON_START=false
# Demo only: slow each entity so a crash/cancel can land mid-batch
BULK_DEBUG_ENTITY_DELAY_MS=0
