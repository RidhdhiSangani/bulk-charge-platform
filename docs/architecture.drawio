<mxfile host="app.diagrams.net" agent="bulk-charge-platform" version="24.0.0"><diagram id="sys" name="1. System architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys_1" value="&lt;b&gt;Bulk Charge Application Platform — System Architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="sys_2" value="NestJS · PostgreSQL 16 (source of truth, exactly-once) · Redis 7 + BullMQ (queues, delays, rate limit) · numbered arrows = life of one bulk job" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="1500" height="24" as="geometry"/></mxCell><mxCell id="sys_3" value="Clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="600" as="geometry"/></mxCell><mxCell id="sys_4" value="&lt;b&gt;Postman / curl&lt;/b&gt;&lt;br&gt;REST calls&lt;br&gt;Idempotency-Key header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="190" height="80" as="geometry"/></mxCell><mxCell id="sys_5" value="&lt;b&gt;Swagger UI&lt;/b&gt;&lt;br&gt;GET /docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="190" height="60" as="geometry"/></mxCell><mxCell id="sys_6" value="&lt;b&gt;Live progress viewer&lt;/b&gt;&lt;br&gt;EventSource / curl -N&lt;br&gt;text/event-stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="190" height="80" as="geometry"/></mxCell><mxCell id="sys_7" value="&lt;b&gt;GitHub Actions CI&lt;/b&gt;&lt;br&gt;typecheck · build · 16 unit&lt;br&gt;+ 17 integration tests&lt;br&gt;(real Postgres + Redis)&lt;br&gt;+ docker build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="190" height="110" as="geometry"/></mxCell><mxCell id="sys_8" value="Application — one Docker image, two roles (NestJS / TypeScript)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=14;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1060" height="1010" as="geometry"/></mxCell><mxCell id="sys_9" value="API process — dist/main.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="500" height="480" as="geometry"/></mxCell><mxCell id="sys_10" value="&lt;b&gt;BulkJobsController&lt;/b&gt;  (ValidationPipe: whitelist, forbid unknown)&lt;br&gt;POST /v1/bulk-jobs · GET /v1/bulk-jobs · GET /:id&lt;br&gt;GET /:id/events (SSE) · /:id/summary · /:id/entries?outcome=&lt;br&gt;POST /:id/cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="165" width="460" height="90" as="geometry"/></mxCell><mxCell id="sys_11" value="&lt;b&gt;BulkJobsService&lt;/b&gt;&lt;br&gt;• Idempotency: UNIQUE(tenant, key) + request_hash → 200 replay / 422&lt;br&gt;• Validate via registries: adapter.validateFilter (allowlist → 400),&lt;br&gt;  action.validateParams&lt;br&gt;• scheduled_at → status scheduled + delayed orchestrate job&lt;br&gt;• detail / summary (reasons) / entries (cursor) / events (1 s push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="270" width="460" height="145" as="geometry"/></mxCell><mxCell id="sys_12" value="&lt;b&gt;CancelService&lt;/b&gt;&lt;br&gt;scheduled/queued → cancelled + remove delayed job&lt;br&gt;running → cancel_requested_at + close pending batches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="300" height="85" as="geometry"/></mxCell><mxCell id="sys_13" value="&lt;b&gt;Health&lt;/b&gt; /health&lt;br&gt;&lt;b&gt;Shipments&lt;/b&gt; /v1/shipments/:no&lt;br&gt;&lt;b&gt;Swagger&lt;/b&gt; /docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="655" y="430" width="145" height="85" as="geometry"/></mxCell><mxCell id="sys_14" value="Returns immediately — never processes entities (except combined mode, see Deployment)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#34568b;" vertex="1" parent="1"><mxGeometry x="340" y="530" width="460" height="40" as="geometry"/></mxCell><mxCell id="sys_15" value="Worker process — dist/worker.js  (× N replicas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="500" height="480" as="geometry"/></mxCell><mxCell id="sys_16" value="&lt;b&gt;OrchestratorProcessor&lt;/b&gt;  (queue bulk-orchestrate)&lt;br&gt;1. scheduled/queued → running (conditional: cancel wins)&lt;br&gt;2. COUNT(*) → total_matched&lt;br&gt;3. loop: scanPage(id &amp;gt; cursor, 100) → upsert job_batches&lt;br&gt;    → enqueue process-batch → save cursor_after_id&lt;br&gt;4. scan_complete, reconcile total → tryFinish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="165" width="460" height="120" as="geometry"/></mxCell><mxCell id="sys_17" value="&lt;b&gt;BatchProcessor&lt;/b&gt;  (queue bulk-batches, concurrency 4)&lt;br&gt;1. tenant rate limit → refused? moveToDelayed(retryAfter)&lt;br&gt;2. claim lease: UPDATE … SET lease_owner = token&lt;br&gt;3. BEGIN · skip already-logged · SELECT … FOR UPDATE (id order)&lt;br&gt;4. per entity: SAVEPOINT → action.execute → outcome&lt;br&gt;5. job_entries + counters (once) · fenced UPDATE done&lt;br&gt;6. COMMIT → JobFinalizer.tryFinish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="460" height="135" as="geometry"/></mxCell><mxCell id="sys_18" value="&lt;b&gt;WatchdogProcessor&lt;/b&gt;  (repeatable, every 15 s)&lt;br&gt;expired leases → pending · orphaned batches → re-enqueue&lt;br&gt;stalled / past-due orchestration → re-enqueue · finalise drained jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="450" width="460" height="75" as="geometry"/></mxCell><mxCell id="sys_19" value="Add replicas to scale: each batch claim is atomic, so N workers never double-process." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#3b6e2b;" vertex="1" parent="1"><mxGeometry x="860" y="535" width="460" height="40" as="geometry"/></mxCell><mxCell id="sys_20" value="Engine core — src/bulk-engine (entity-agnostic: zero shipment imports; shared by both processes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="1020" height="190" as="geometry"/></mxCell><mxCell id="sys_21" value="&lt;b&gt;Interfaces&lt;/b&gt;&lt;br&gt;BulkAction: validateParams, execute&lt;br&gt;EntityAdapter: validateFilter, count,&lt;br&gt;scanPage, lockByIds, matchesFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="665" width="240" height="135" as="geometry"/></mxCell><mxCell id="sys_22" value="&lt;b&gt;ActionRegistry&lt;/b&gt;&lt;br&gt;key entity:action&lt;br&gt;&lt;b&gt;AdapterRegistry&lt;/b&gt;&lt;br&gt;key entity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="595" y="665" width="150" height="135" as="geometry"/></mxCell><mxCell id="sys_23" value="&lt;b&gt;TenantRateLimiter&lt;/b&gt;&lt;br&gt;strict sliding window&lt;br&gt;Lua on Redis ZSET&lt;br&gt;entities / tenant / 60 s&lt;br&gt;returns retry-after ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="665" width="180" height="135" as="geometry"/></mxCell><mxCell id="sys_24" value="&lt;b&gt;ProgressService&lt;/b&gt;&lt;br&gt;processed / total, %&lt;br&gt;throughput / min&lt;br&gt;linear ETA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="955" y="665" width="160" height="135" as="geometry"/></mxCell><mxCell id="sys_25" value="&lt;b&gt;JobFinalizer&lt;/b&gt;&lt;br&gt;no pending/leased batch&lt;br&gt;→ completed | cancelled&lt;br&gt;(conditional UPDATE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1130" y="665" width="190" height="135" as="geometry"/></mxCell><mxCell id="sys_26" value="Shipment plugin — src/actions   (adding an action = 1 class + 1 register() line in ShipmentModule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="840" width="1020" height="240" as="geometry"/></mxCell><mxCell id="sys_27" value="&lt;b&gt;ShipmentAdapter&lt;/b&gt;&lt;br&gt;filter allowlist: origin_port, destination_port,&lt;br&gt;status, trade_type, customer_id&lt;br&gt;keyset scan on BIGSERIAL id&lt;br&gt;lockByIds: SELECT … FOR UPDATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="875" width="300" height="115" as="geometry"/></mxCell><mxCell id="sys_28" value="&lt;b&gt;ApplyChargeAction&lt;/b&gt;  (apply_charge)&lt;br&gt;exists (shipment, code)? → skipped&lt;br&gt;is_billed? → failed already_billed&lt;br&gt;Decimal pricing: per_container | per_kg | flat&lt;br&gt;FX convert (missing pair → failed)&lt;br&gt;INSERT … ON CONFLICT DO NOTHING → success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="655" y="875" width="330" height="115" as="geometry"/></mxCell><mxCell id="sys_29" value="&lt;b&gt;TransitionStatusAction&lt;/b&gt;  (transition_status)&lt;br&gt;booked → in_transit → arrived → delivered&lt;br&gt;next step only; else failed illegal_transition&lt;br&gt;same status → skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000" y="875" width="320" height="115" as="geometry"/></mxCell><mxCell id="sys_30" value="&lt;b&gt;FxService&lt;/b&gt;  fx_rates cached 60 s · direct or inverse pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="655" y="1005" width="330" height="50" as="geometry"/></mxCell><mxCell id="sys_31" value="&lt;b&gt;status-machine.ts&lt;/b&gt;  canTransition(from, to)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000" y="1005" width="320" height="50" as="geometry"/></mxCell><mxCell id="sys_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;endArrow=block;endFill=1;fontColor=#9673a6;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_28" target="sys_30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;endArrow=block;endFill=1;fontColor=#9673a6;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_29" target="sys_31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_34" value="Redis 7 — BullMQ + rate limiter  (rebuildable from Postgres)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1400" y="90" width="560" height="330" as="geometry"/></mxCell><mxCell id="sys_35" value="&lt;b&gt;queue bulk-orchestrate&lt;/b&gt;&lt;br&gt;job id orch-&amp;lt;jobId&amp;gt; · delayed until scheduled_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="130" width="520" height="55" as="geometry"/></mxCell><mxCell id="sys_36" value="&lt;b&gt;queue bulk-batches&lt;/b&gt;&lt;br&gt;one job per batch (not per shipment) · id b-&amp;lt;jobId&amp;gt;-&amp;lt;n&amp;gt;&lt;br&gt;attempts 10, exponential backoff, stalled detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="200" width="520" height="70" as="geometry"/></mxCell><mxCell id="sys_37" value="&lt;b&gt;queue bulk-watchdog&lt;/b&gt;&lt;br&gt;job scheduler: every 15 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="285" width="520" height="50" as="geometry"/></mxCell><mxCell id="sys_38" value="&lt;b&gt;ZSET bulk:rate:&amp;lt;tenant&amp;gt;&lt;/b&gt;&lt;br&gt;grants &quot;&amp;lt;uuid&amp;gt;:&amp;lt;count&amp;gt;&quot; scored by Redis TIME — last 60 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="350" width="520" height="55" as="geometry"/></mxCell><mxCell id="sys_39" value="PostgreSQL 16 — source of truth (unique constraints = exactly-once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=13;arcSize=4;align=center;spacingLeft=6;spacingRight=6;verticalAlign=top;fontStyle=1;spacingTop=4;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1400" y="450" width="560" height="650" as="geometry"/></mxCell><mxCell id="sys_40" value="&lt;b&gt;shipments&lt;/b&gt;&lt;br&gt;BIGSERIAL id (keyset cursor) · tenant_id · shipment_no&lt;br&gt;ports · status · container_count · chargeable_weight&lt;br&gt;billing_currency · is_billed&lt;br&gt;idx (tenant, origin_port, status, id) …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="490" width="520" height="95" as="geometry"/></mxCell><mxCell id="sys_41" value="&lt;b&gt;shipment_charges&lt;/b&gt;   UNIQUE(shipment_id, charge_code)&lt;br&gt;basis · rate · currency · amount · fx_rate · amount_billing · bulk_job_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="600" width="520" height="55" as="geometry"/></mxCell><mxCell id="sys_42" value="&lt;b&gt;fx_rates&lt;/b&gt;  UNIQUE(base, quote)      &lt;b&gt;tenants&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="670" width="520" height="40" as="geometry"/></mxCell><mxCell id="sys_43" value="&lt;b&gt;bulk_jobs&lt;/b&gt;   UNIQUE(tenant_id, idempotency_key)&lt;br&gt;filter / params JSONB · status · counters · total_matched&lt;br&gt;cursor_after_id · next_batch_no · scan_complete · request_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="725" width="520" height="75" as="geometry"/></mxCell><mxCell id="sys_44" value="&lt;b&gt;job_batches&lt;/b&gt;   UNIQUE(job_id, batch_no)&lt;br&gt;entity_ids BIGINT[] (≤100, frozen) · status pending → leased → done | cancelled&lt;br&gt;leased_at · lease_owner (fencing token) · attempt_count · queue_job_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="815" width="520" height="75" as="geometry"/></mxCell><mxCell id="sys_45" value="&lt;b&gt;job_entries&lt;/b&gt;   UNIQUE(job_id, entity_id)  — per-entity log&lt;br&gt;outcome success | failed | skipped · reason · entity_ref · batch_id&lt;br&gt;idx (job_id, outcome, id) → filtered, paginated /entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="905" width="520" height="75" as="geometry"/></mxCell><mxCell id="sys_46" value="Per batch, everything commits in ONE transaction: charges / status updates + job_entries + counters + batch done." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#3d5a80;" vertex="1" parent="1"><mxGeometry x="1420" y="995" width="520" height="45" as="geometry"/></mxCell><mxCell id="sys_47" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#1f5fbf;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#1f5fbf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_4" target="sys_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;endArrow=block;endFill=1;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_5" target="sys_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_49" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#1f5fbf;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#1f5fbf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_11" target="sys_43"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="834" y="313"/><mxPoint x="834" y="620"/><mxPoint x="1390" y="620"/><mxPoint x="1390" y="762"/></Array></mxGeometry></mxCell><mxCell id="sys_50" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#1f5fbf;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#1f5fbf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_11" target="sys_35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="826" y="284"/><mxPoint x="826" y="78"/><mxPoint x="1576" y="78"/></Array></mxGeometry></mxCell><mxCell id="sys_51" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_35" target="sys_16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_52" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_16" target="sys_40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1366" y="273"/><mxPoint x="1366" y="518"/></Array></mxGeometry></mxCell><mxCell id="sys_53" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_16" target="sys_36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_54" value="⑦" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_36" target="sys_17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1348" y="259"/><mxPoint x="1348" y="313"/></Array></mxGeometry></mxCell><mxCell id="sys_55" value="⑧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#b71c1c;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#b71c1c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_17" target="sys_38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_56" value="⑨ ⑩" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_17" target="sys_44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1376" y="415"/><mxPoint x="1376" y="852"/></Array></mxGeometry></mxCell><mxCell id="sys_57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;endArrow=block;endFill=1;fontColor=#555555;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_18" target="sys_44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1384" y="487"/><mxPoint x="1384" y="879"/></Array></mxGeometry></mxCell><mxCell id="sys_58" value="⑪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#6a1b9a;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#6a1b9a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_11" target="sys_6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="400"/><mxPoint x="300" y="374"/></Array></mxGeometry></mxCell><mxCell id="sys_59" value="✕" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#b71c1c;strokeWidth=1.5;fontSize=15;endArrow=block;endFill=1;fontColor=#b71c1c;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_4" target="sys_12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="190"/><mxPoint x="50" y="472"/></Array></mxGeometry></mxCell><mxCell id="sys_60" value="&lt;b&gt;Deployment&lt;/b&gt;&lt;br&gt;&lt;b&gt;docker-compose&lt;/b&gt;: postgres · redis · migrate (one-shot: migrations + seed) · api · worker (--scale worker=N)&lt;br&gt;&lt;b&gt;Render (free, live demo)&lt;/b&gt;: one web service in &lt;i&gt;combined mode&lt;/i&gt; (RUN_WORKERS_IN_API=true → workers run inside the API process)&lt;br&gt;+ managed Postgres + Key Value (Redis, noeviction) — render.yaml Blueprint, MIGRATE_ON_START=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1320" height="95" as="geometry"/></mxCell><mxCell id="sys_61" value="&lt;b&gt;Why exactly-once holds&lt;/b&gt;&lt;br&gt;• atomic lease claim  • fencing token at commit (stale worker rolls back)&lt;br&gt;• UNIQUE(job_id, entity_id)  • UNIQUE(shipment_id, charge_code)&lt;br&gt;• batch = 1 tx; crash before commit → nothing persisted → re-claimed&lt;br&gt;• orchestrator cursor saved per page; batch upsert on (job_id, batch_no)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#b0a060;fontSize=12;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1120" width="560" height="120" as="geometry"/></mxCell><mxCell id="sys_62" value="&lt;b&gt;Life of a bulk job&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;&lt;b&gt;①&lt;/b&gt;&lt;/font&gt; POST /v1/bulk-jobs: filter + action + params (+ scheduled_at, Idempotency-Key)&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;&lt;b&gt;②&lt;/b&gt;&lt;/font&gt; INSERT bulk_jobs (scheduled | queued); same key → original job&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;&lt;b&gt;③&lt;/b&gt;&lt;/font&gt; enqueue orchestrate, delayed until scheduled_at&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;④&lt;/b&gt;&lt;/font&gt; orchestrator picks it up → running&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;⑤&lt;/b&gt;&lt;/font&gt; COUNT + keyset-scan ids, 100 per page (never all in memory)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;⑥&lt;/b&gt;&lt;/font&gt; upsert job_batches row + enqueue process-batch; save cursor&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;⑦&lt;/b&gt;&lt;/font&gt; any of N workers consumes the batch&lt;br&gt;&lt;font color=&quot;#b71c1c&quot;&gt;&lt;b&gt;⑧&lt;/b&gt;&lt;/font&gt; tenant rate limit (5,000/min); refused → delayed, not dropped&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;⑨&lt;/b&gt;&lt;/font&gt; claim lease (fencing token)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;⑩&lt;/b&gt;&lt;/font&gt; 1 tx: lock rows, SAVEPOINT per entity, charges/status, job_entries, counters, fenced done&lt;br&gt;&lt;font color=&quot;#6a1b9a&quot;&gt;&lt;b&gt;⑪&lt;/b&gt;&lt;/font&gt; observe: detail · summary · entries · SSE /events&lt;br&gt;&lt;font color=&quot;#b71c1c&quot;&gt;&lt;b&gt;✕&lt;/b&gt;&lt;/font&gt; cancel: pending batches closed, in-flight stop at next check&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;- - -&lt;/font&gt; watchdog reconciles leases / orphans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="240" height="390" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2. Batch processing &amp; state machines"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow_1" value="&lt;b&gt;Batch processing — one BatchProcessor run (≤ 100 entities)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="flow_2" value="process-batch job received" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="250" height="45" as="geometry"/></mxCell><mxCell id="flow_3" value="batch done / cancelled?&lt;br&gt;job cancelled / terminal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="125" width="330" height="80" as="geometry"/></mxCell><mxCell id="flow_4" value="ack (close pending batch if job cancelled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="250" height="50" as="geometry"/></mxCell><mxCell id="flow_5" value="tenant rate limit:&lt;br&gt;acquire(tenant, n)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="225" width="330" height="80" as="geometry"/></mxCell><mxCell id="flow_6" value="moveToDelayed(retryAfterMs + jitter)&lt;br&gt;DelayedError — not a failure, no retry used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="310" height="55" as="geometry"/></mxCell><mxCell id="flow_7" value="claim lease&lt;br&gt;(pending, or leased &amp; expired)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="325" width="330" height="80" as="geometry"/></mxCell><mxCell id="flow_8" value="release tokens · done → ack&lt;br&gt;held by a live worker → delay 5 s (do NOT ack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="340" width="310" height="55" as="geometry"/></mxCell><mxCell id="flow_9" value="&lt;b&gt;BEGIN&lt;/b&gt; transaction · skip ids already in job_entries (resume)&lt;br&gt;SELECT … FOR UPDATE entities ORDER BY id (no deadlocks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="130" y="425" width="370" height="60" as="geometry"/></mxCell><mxCell id="flow_10" value="for each entity&lt;br&gt;(every 10: cancel requested?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="505" width="330" height="80" as="geometry"/></mxCell><mxCell id="flow_11" value="stop early · batch → cancelled&lt;br&gt;(entities finished so far are kept)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="280" height="55" as="geometry"/></mxCell><mxCell id="flow_12" value="entity exists and still&lt;br&gt;matches the filter?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="605" width="330" height="80" as="geometry"/></mxCell><mxCell id="flow_13" value="skipped: entity_not_found /&lt;br&gt;no_longer_matches_filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="620" width="280" height="55" as="geometry"/></mxCell><mxCell id="flow_14" value="&lt;b&gt;SAVEPOINT&lt;/b&gt; → action.execute(entity, params, ctx)&lt;br&gt;returns success | failed | skipped + reason&lt;br&gt;throws → ROLLBACK TO SAVEPOINT → failed unexpected_error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="130" y="705" width="370" height="70" as="geometry"/></mxCell><mxCell id="flow_15" value="after loop: INSERT job_entries (all) · UPDATE bulk_jobs counters (once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="130" y="795" width="370" height="50" as="geometry"/></mxCell><mxCell id="flow_16" value="UPDATE job_batches SET done&lt;br&gt;WHERE lease_owner = my token" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#3d5a80;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="865" width="330" height="80" as="geometry"/></mxCell><mxCell id="flow_17" value="0 rows: lease was stolen → LeaseLostError&lt;br&gt;&lt;b&gt;ROLLBACK whole batch&lt;/b&gt; (zombie cannot commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="570" y="880" width="320" height="55" as="geometry"/></mxCell><mxCell id="flow_18" value="&lt;b&gt;COMMIT&lt;/b&gt; → JobFinalizer.tryFinish(job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="170" y="965" width="290" height="45" as="geometry"/></mxCell><mxCell id="flow_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;endArrow=block;endFill=1;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow_2" target="flow_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#333333;strokeWidth=1.5